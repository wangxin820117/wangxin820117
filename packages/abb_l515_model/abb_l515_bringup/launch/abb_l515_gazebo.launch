<?xml version="1.0"?>
<launch>

  <!-- remap topics to conform to ROS-I specifications -->
  <remap from="/arm_controller/follow_joint_trajectory" to="/joint_trajectory_action" />
  <remap from="/arm_controller/state" to="/feedback_states" />
  <remap from="/arm_controller/command" to="/joint_path_command"/>


  <arg name="egm"/>

  <!-- start simulated world -->
  <arg name="usecase"/>
  <arg name="model" default="tomato8"/>
  <group if="$(eval usecase == 'poultry')">
    <include file="$(find poultry_gazebo)/launch/poultry_gazebo.launch"/>
  </group>
  <group if="$(eval usecase == 'greenhouse')">
    <include file="$(find greenhouse_gazebo)/launch/greenhouse_gazebo.launch">
      <arg name="model" value="$(arg model)"/>
    </include>
  </group>

  <!-- load urdf -->
  <param name="robot_description" command="$(find xacro)/xacro '$(find abb_l515_description)/urdf/abb_l515.xacro'" />

  <!-- spawn robot in gazebo -->
  <node name="abb_l515_spawn" pkg="gazebo_ros" type="spawn_model" output="screen" args="-urdf -param robot_description -model abb_l515" />

  <!-- arm controller -->
  <include file="$(find abb_irb1200_gazebo)/launch/irb1200_5_90_control.launch"/>
  
</launch>
