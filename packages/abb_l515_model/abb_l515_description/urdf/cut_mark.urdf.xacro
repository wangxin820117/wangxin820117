<?xml version="1.0"?>

<!-- Gripper shell -->

<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find ur_description)/urdf/common_materials.xacro"/>


  <xacro:macro name="cut_mark" params="parent name">
    <!-- Links -->
    <link name="${name}_link">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
      <collision>
        <geometry>
          <mesh filename="package://abb_l515_description/meshes/gripper/sphere.stl" scale="0.00015 0.0001 0.0001" />
        </geometry>
      </collision>
      <visual>
        <geometry>
          <mesh filename="package://abb_l515_description/meshes/gripper/sphere.stl" scale="0.00015 0.0001 0.0001" />
        </geometry>
        <xacro:material_abb_white />
      </visual>
    </link>
  </xacro:macro>
</robot>
